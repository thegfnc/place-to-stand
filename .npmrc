# Only install versions published at least 7 days ago. Applies to transitive
# deps too; older npm versions ignore these keys with a warning.
min-release-age=7

# React ships straight to latest. scheduler is exact-pinned by react-dom, so it
# has to be exempt too or a fresh react-dom release can't resolve.
min-release-age-exclude[]=react
min-release-age-exclude[]=react-dom
min-release-age-exclude[]=scheduler
min-release-age-exclude[]=@types/react
min-release-age-exclude[]=@types/react-dom

# Next.js ships straight to latest. @next/* covers the exact-pinned SWC
# binaries and @next/env that release in lockstep with next.
min-release-age-exclude[]=next
min-release-age-exclude[]=@next/*
min-release-age-exclude[]=eslint-config-next
